{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "固件: 合并 BIN",
            "type": "process",
            "command": "py",
            "args": [
                "-u",
                "${workspaceFolder}\\Tools\\merge_bin\\merge_bin.py",
                "${workspaceFolder}\\Tools\\merge_bin\\merge_bin_config.json"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "statusbar": {
                    "label": "$(tools) 合并固件",
                    "detail": "生成 ba_fan_firmware.bin 和 ba_fan_upgrade.bin"
                }
            },
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "J-Link: 擦除 Flash",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\Tools\\jlink\\jlink_flash.ps1",
                "-EraseOnly",
                "-JLinkExe",
                "D:\\Keil_v5\\ARM\\Segger\\JLink.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "statusbar": {
                    "label": "$(trash) 擦除 Flash",
                    "detail": "通过 J-Link 擦除整片 Flash"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                //"close": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "J-Link: 复位并运行",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\Tools\\jlink\\jlink_flash.ps1",
                "-ResetOnly",
                "-JLinkExe",
                "D:\\Keil_v5\\ARM\\Segger\\JLink.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "statusbar": {
                    "label": "$(debug-restart) 复位并运行",
                    "detail": "通过 J-Link 复位目标芯片并继续运行"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                //"close": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "J-Link: 烧录完整固件",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\Tools\\jlink\\jlink_flash.ps1",
                "${workspaceFolder}\\Projects\\Output\\ba_fan_firmware.bin",
                "-EraseAll",
                "-JLinkExe",
                "D:\\Keil_v5\\ARM\\Segger\\JLink.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "statusbar": {
                    "label": "$(cloud-upload) 烧录固件",
                    "detail": "整片擦除并烧录 ba_fan_firmware.bin"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "J-Link: 仅烧录 App",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\Tools\\jlink\\jlink_flash.ps1",
                "${workspaceFolder}\\Projects\\Output\\ba_fan_app.bin",
                "-Address",
                "0x08004000",
                "-RegionStart",
                "0x08004000",
                "-RegionEnd",
                "0x0800FDFF",
                "-JLinkExe",
                "D:\\Keil_v5\\ARM\\Segger\\JLink.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "statusbar": {
                    "label": "$(chip) 烧录 App",
                    "detail": "烧录 ba_fan_app.bin，保留 Boot 和参数区"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "J-Link: 仅烧录 Boot",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\Tools\\jlink\\jlink_flash.ps1",
                "${workspaceFolder}\\Projects\\Output\\ba_fan_boot.bin",
                "-Address",
                "0x08000000",
                "-RegionStart",
                "0x08000000",
                "-RegionEnd",
                "0x08003FFF",
                "-JLinkExe",
                "D:\\Keil_v5\\ARM\\Segger\\JLink.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "statusbar": {
                    "label": "$(chip) 烧录 Boot",
                    "detail": "烧录 ba_fan_boot.bin，保留 App 和参数区"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "串口: 通信协议测试",
            "type": "process",
            "command": "py",
            "args": [
                "-u",
                "${workspaceFolder}\\Tools\\serial_test\\serial_test.py",
                "--baudrate",
                "${input:serialBaudrate}"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "statusbar": {
                    "label": "$(plug) 串口监控",
                    "detail": "显示带时间戳的串口数据"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false
            }
        }
    ],
    "inputs": [
        {
            "id": "serialBaudrate",
            "type": "promptString",
            "description": "请输入串口波特率",
            "default": "115200"
        }
    ]
}
